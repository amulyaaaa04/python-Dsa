#include <iostream>
#include <string>
using namespace std;

int main() {
    string name, destination;
    int choice, tickets;
    float price = 0;

    cout << "===== TRAVEL BOOKING PLATFORM =====\n\n";

    cout << "Enter Passenger Name: ";
    getline(cin, name);

    cout << "Enter Destination: ";
    getline(cin, destination);

    cout << "\nSelect Travel Mode\n";
    cout << "1. Bus (Rs.500)\n";
    cout << "2. Train (Rs.800)\n";
    cout << "3. Flight (Rs.3000)\n";
    cout << "Enter Choice: ";
    cin >> choice;

    cout << "Number of Tickets: ";
    cin >> tickets;

    switch(choice) {
        case 1:
            price = 500 * tickets;
            break;
        case 2:
            price = 800 * tickets;
            break;
        case 3:
            price = 3000 * tickets;
            break;
        default:
            cout << "Invalid Choice!";
            return 0;
    }

    cout << "\n===== BOOKING CONFIRMATION =====\n";
    cout << "Passenger Name : " << name << endl;
    cout << "Destination    : " << destination << endl;

    if(choice == 1)
        cout << "Travel Mode    : Bus\n";
    else if(choice == 2)
        cout << "Travel Mode    : Train\n";
    else
        cout << "Travel Mode    : Flight\n";

    cout << "Tickets Booked : " << tickets << endl;
    cout << "Total Amount   : Rs." << price << endl;

    cout << "\nThank you for booking with us!\n";

    return 0;
}